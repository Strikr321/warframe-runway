# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Defaults below match docker-compose.yml for local development only.

DB_NAME=runway
DB_USER=runway
DB_PASSWORD=runway
DB_URL=jdbc:postgresql://localhost:5432/runway

# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Google OAuth2 client (Google Cloud Console → Google Auth Platform → Clients).
# Authorized redirect URI must be: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the API sends the browser after sign-in, and the base of the OAuth redirect URI
FRONTEND_URL=http://localhost:4200
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080
